# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Opcja 1: Użyj wbudowanego PostgreSQL (domyślnie)
# Ustaw tylko hasło:
POSTGRES_PASSWORD=YourStrongPasswordHere123!
POSTGRES_DB=fifatracker
POSTGRES_USER=postgres

# POSTGRES_DATA_PATH=/home/user/fifatracker-data

# Opcja 2: Podłącz się do istniejącej bazy danych
# Ustaw wszystkie poniższe zmienne i zakomentuj sekcję 'postgres' w docker-compose
# POSTGRES_HOST=192.168.1.100
# POSTGRES_PORT=5432
# POSTGRES_DB=fifatracker
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YourExternalDatabasePassword123!

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Frontend API URL (relatywna ścieżka - nginx obsłuży routing)
# Zostaw puste lub ustaw /api (bez domeny, bez portu!)
VITE_API_BASE_URL=/api

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS Origins (comma-separated)
# Dla Cloudflare: ustaw domenę BEZ portu
# Dla lokalnych testów: zostaw puste (akceptuje wszystko)
ALLOWED_ORIGINS=https://yourdomain.com

# Dla wielu domen:
# ALLOWED_ORIGINS=https://fifatracker.com,https://app.fifatracker.com

# Dla lokalnych testów (akceptuje wszystko):
# ALLOWED_ORIGINS=
